[Unit]
Description=Project Aegis security monitoring daemon
After=network-online.target rsyslog.service ufw.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u __PROJECT_DIR__/daemon.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
